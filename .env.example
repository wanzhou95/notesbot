# ===== NotesBot 服务端密钥模板 =====
# 复制本文件为 .env 并填写真实值；.env 已在 .gitignore 中排除，切勿提交。
# 写入方式（不回显、不进历史）：sudo /srv/app/notesbot/set-secret.sh 变量名

# ===== 大模型（主力 DeepSeek，备用智谱 GLM 免费）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_ROUTER=deepseek-flash
MODEL_MAIN=deepseek-v4-pro

# ===== 备用模型（智谱 GLM，免费）=====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_GLM=glm-4.7-flash
# 降级链：从左到右依次尝试。glm-5.3-flash 有免费额度时放最前面
MODEL_FALLBACK=glm-5.3-flash,glm-4.7-flash,glm-4-flash
# 定时归纳的最终兜底（独立于上面的顺序，默认 glm-4.7-flash，不要随便改）
MODEL_GLM_FINAL=glm-4.7-flash
# 思考模型（glm-5.3-flash）的最小 max_tokens 保底：给太小会 200 但正文为空
MODEL_THINK_MIN_TOKENS=300
# 截断重试：正文非空但 finish_reason=length（思考把预算吃光、只写了半句）时翻倍重试一次。
# 只对 max_tokens ≥ RETRY_MIN 的调用生效（短调用如 30 token 归类不重试），翻倍上限 RETRY_CAP
MODEL_LENGTH_RETRY_MIN=400
MODEL_LENGTH_RETRY_CAP=8000
# GLM 为混合思考模型，必须关闭思考，否则 token 全耗在推理、正文为空
GLM_DISABLE_THINKING=1

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 企业微信 =====
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ===== Embedding（复用 GLM key，embedding-2 免费 1024 维）=====
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=embedding-2

# ===== 用户与账号（开箱即用，首次启动自动建账号和目录）=====
# 方式A（推荐多用户）：配置初始用户列表，格式「名字:角色」逗号分隔
#   admin=管理员（可跨库只读检索）  user=普通用户（只见自己的库）
# USERS=alice:admin,bob:user,carol:user
# 各账号初始密码（可选，缺省自动生成随机密码并打印到服务日志）：
# PASS_alice=123456
# PASS_bob=123456
#
# 方式B（单用户）：不配 USERS，首次启动自动创建下面的默认管理员
ADMIN_USER=admin
ADMIN_PASS=

# ===== 网页端管理员口令（旧字段，已弃用，可留空）=====
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=

# ===== 路径（可选，换机器部署时覆盖默认值）=====
# NOTES_ROOT=/srv/notes
# NOTESBOT_DATA=/srv/app/notesbot/data
# NOTESBOT_ENV=/srv/app/notesbot/.env

# ===== 定时归纳（manage.py digest / notesbot-digest.timer）=====
# 1=草稿模式：产出落在 05-Skills/_待审/，人工确认后再挪进正式目录（建议先用这个）
# 0=直接写入 05-Skills 正式目录
DIGEST_DRAFT=1
# 每轮每个用户最多处理几个候选，防止一次跑太多烧 token
DIGEST_MAX=3


# ===== 视频 → 字幕 → 速览（video.py）=====
# 语音识别模型（智谱）：单次上限 30 秒，代码会自动切片
MODEL_ASR=glm-asr-2512
# 语音识别供应商：
#   sensevoice（默认）—— 本地 sherpa-onnx 跑 SenseVoice-Small int8：0 元、RTF≈0.06、峰值约 421MB
#   deepseek —— 云端 POST /v1/tools/asr，约 0.41 元/小时；本地不可用时自动兜底
#   glm —— 智谱，支持 prompt 上下文（需资源包）
ASR_PROVIDER=sensevoice
# 本地 SenseVoice 模型目录（model.int8.onnx + tokens.txt，约 230MB）
# 下载：https://hf-mirror.com/csukuangfj/sherpa-onnx-sense-voice-zh-en-ja-ko-yue-2024-07-17
SENSEVOICE_DIR=
# 本地识别用几个线程（2 核机器给 2 即可）
SENSEVOICE_THREADS=2
# 加载本地模型前要求的最低可用内存（MB），不够就自动走云端
SENSEVOICE_MIN_FREE_MB=520
# 本地识别同时跑几段（默认 1；每段峰值约 421MB，调大前先算内存）
ASR_CONCURRENCY=1
# 单个视频最长多少分钟，超过直接拒（防手滑烧钱）
VIDEO_MAX_MIN=180
# 视频笔记目录（这个目录不会进向量库）
VIDEO_DIR=03-Resources/视频字幕
# 同时处理几个视频任务（默认 1）。本地 ASR 每任务峰值约 421MB + ffmpeg 切片吃 CPU，
# 2 核 1.9G 机器建议就保持 1。
VIDEO_CONCURRENCY=1
# 可用内存低于这个值（MB）时任务先等待，避免 OOM 把服务整个干掉
VIDEO_MIN_FREE_MB=220
# 可选：B 站登录 Cookie，能解锁「平台字幕」和更高音质；不填也能用（走 DASH 音频转写）
# BILI_COOKIE=SESSDATA=xxxx; bili_jct=xxxx
# 可选：cookies.txt 路径，给抖音等需要登录的平台用（浏览器插件导出 Netscape 格式）
# YTDLP_COOKIES=/srv/app/notesbot/cookies.txt
# 可选：指定 ffmpeg 路径；不填优先系统 ffmpeg，再退回 imageio-ffmpeg 自带的静态版
# FFMPEG_BIN=/usr/bin/ffmpeg
