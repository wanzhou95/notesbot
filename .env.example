# ===== NotesBot 服务端密钥模板 =====
# 复制本文件为 .env 并填写真实值；.env 已在 .gitignore 中排除，切勿提交。
# 写入方式（不回显、不进历史）：sudo /srv/app/notesbot/set-secret.sh 变量名

# ===== 大模型（主力 DeepSeek，备用智谱 GLM 免费）=====
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_ROUTER=deepseek-flash
MODEL_MAIN=deepseek-v4-pro

# ===== 备用模型（智谱 GLM，免费）=====
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
MODEL_GLM=glm-4.7-flash
# 降级链：从左到右依次尝试。glm-5.3-flash 有免费额度时放最前面
MODEL_FALLBACK=glm-5.3-flash,glm-4.7-flash,glm-4-flash
# GLM 为混合思考模型，必须关闭思考，否则 token 全耗在推理、正文为空
GLM_DISABLE_THINKING=1

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# ===== 企业微信 =====
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ===== Embedding（复用 GLM key，embedding-2 免费 1024 维）=====
EMBED_API_KEY=
EMBED_BASE_URL=
EMBED_MODEL=embedding-2

# ===== 用户与账号（开箱即用，首次启动自动建账号和目录）=====
# 方式A（推荐多用户）：配置初始用户列表，格式「名字:角色」逗号分隔
#   admin=管理员（可跨库只读检索）  user=普通用户（只见自己的库）
# USERS=alice:admin,bob:user,carol:user
# 各账号初始密码（可选，缺省自动生成随机密码并打印到服务日志）：
# PASS_alice=123456
# PASS_bob=123456
#
# 方式B（单用户）：不配 USERS，首次启动自动创建下面的默认管理员
ADMIN_USER=admin
ADMIN_PASS=

# ===== 网页端管理员口令（旧字段，已弃用，可留空）=====
WEB_ADMIN_USER=admin
WEB_ADMIN_PASS=

# ===== 路径（可选，换机器部署时覆盖默认值）=====
# NOTES_ROOT=/srv/notes
# NOTESBOT_DATA=/srv/app/notesbot/data
# NOTESBOT_ENV=/srv/app/notesbot/.env

# ===== 定时归纳（manage.py digest / notesbot-digest.timer）=====
# 1=草稿模式：产出落在 05-Skills/_待审/，人工确认后再挪进正式目录（建议先用这个）
# 0=直接写入 05-Skills 正式目录
DIGEST_DRAFT=1
# 每轮每个用户最多处理几个候选，防止一次跑太多烧 token
DIGEST_MAX=3

